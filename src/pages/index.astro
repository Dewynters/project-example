---
import Layout from "../layouts/Layout.astro";
import AboutBlock from "../components/AboutBlock.astro";
import TourDateList from "../components/TourDateList.tsx";
import tourDates from "../data/tour-dates.json";
---

<Layout title="Shows">
	<main class="min-h-screen bg-gradient-to-b from-indigo-50/70 via-neutral-50 to-neutral-50 px-4 py-12 md:py-16">
		<div class="mx-auto max-w-5xl space-y-10">
			<h1 class="bg-gradient-to-r from-indigo-900 to-indigo-700 bg-clip-text text-3xl font-semibold tracking-tight text-transparent md:text-4xl">
				Shows
			</h1>
			<AboutBlock />
			<TourDateList dates={tourDates} />
		</div>
	</main>
</Layout>
