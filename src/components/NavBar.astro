---
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = pathname === "/";
const isAbout = pathname === "/about";

const linkClass = "rounded-md px-3 py-2 text-sm font-medium transition-colors";
---

<nav aria-label="Primary" class="border-b border-indigo-100 bg-white/90 shadow-sm backdrop-blur-sm">
	<div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 md:px-6">
		<a href="/" class="text-sm font-semibold text-indigo-950"> Site </a>
		<ul class="flex items-center gap-1 sm:gap-2">
			<li>
				<a
					href="/"
					class:list={[
						linkClass,
						isHome ? "bg-indigo-100 text-indigo-900" : "text-neutral-600 hover:bg-indigo-50 hover:text-indigo-900",
					]}
				>
					Home
				</a>
			</li>
			<li>
				<a
					href="/about"
					class:list={[
						linkClass,
						isAbout ? "bg-indigo-100 text-indigo-900" : "text-neutral-600 hover:bg-indigo-50 hover:text-indigo-900",
					]}
				>
					About
				</a>
			</li>
		</ul>
	</div>
</nav>
